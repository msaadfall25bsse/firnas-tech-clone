jQuery(document).ready(function($) {
    // Ye function har us cheez par kaam karega jis par 'force-close' class hogi
    $(document).on('click', '.force-close, .dialog-close-button, .elementor-button-link', function(e) {
        
        // Popup ke main container ko dhund kar hide karna
        var popupContainer = $(this).closest('.elementor-popup-modal');
        
        if (popupContainer.length) {
            popupContainer.fadeOut(200); // 200ms mein gayab ho jaye
            $('html').removeClass('elementor-popup-is-visible'); // Scroll unlock karein
        }
    });
});
</script>				</div>
